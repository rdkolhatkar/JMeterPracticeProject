        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="BeanShell – Pre-Test Initialisation" enabled="true">
          <stringProp name="BeanShellSampler.query">
import java.text.SimpleDateFormat;
import java.util.Date;

// ── Record test start timestamp ──────────────────────────────────────
SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;);
String startTime = sdf.format(new Date());
vars.put(&quot;TEST_START_TIME&quot;, startTime);

// ── Derive a unique username suffix per thread ───────────────────────
int threadNum = ctx.getThreadNum() + 1;
String uniqueEmail = &quot;testuser&quot; + threadNum + &quot;@demo.com&quot;;
vars.put(&quot;DYNAMIC_EMAIL&quot;, uniqueEmail);

// ── Log to JMeter log file ───────────────────────────────────────────
log.info(&quot;=== DemoWebShop Test STARTED at &quot; + startTime
         + &quot; | Thread=&quot; + threadNum
         + &quot; | Email=&quot; + uniqueEmail + &quot; ===&quot;);

// ── Initialise counters stored in variables ──────────────────────────
vars.put(&quot;REQUEST_COUNT&quot;, &quot;0&quot;);
vars.put(&quot;PASS_COUNT&quot;,    &quot;0&quot;);
vars.put(&quot;FAIL_COUNT&quot;,    &quot;0&quot;);

// ── Return a friendly label so View Results Tree shows &quot;PASS&quot; ────────
SampleResult.setResponseData(&quot;Pre-Test Init OK – Thread &quot; + threadNum
    + &quot; | Start: &quot; + startTime, &quot;UTF-8&quot;);
SampleResult.setSuccessful(true);
SampleResult.setResponseCodeOK();
          </stringProp>
        </BeanShellSampler>
