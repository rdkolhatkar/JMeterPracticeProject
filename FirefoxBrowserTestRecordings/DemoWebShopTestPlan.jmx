        <hashTree/>
        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="BeanShell – Post-Test Summary" enabled="true">
          <stringProp name="BeanShellSampler.query">
import java.text.SimpleDateFormat;
import java.util.Date;

SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;);
String endTime = sdf.format(new Date());

String startTime    = vars.get(&quot;TEST_START_TIME&quot;);
String passCount    = vars.get(&quot;PASS_COUNT&quot;)    == null ? &quot;0&quot; : vars.get(&quot;PASS_COUNT&quot;);
String failCount    = vars.get(&quot;FAIL_COUNT&quot;)    == null ? &quot;0&quot; : vars.get(&quot;FAIL_COUNT&quot;);
String requestCount = vars.get(&quot;REQUEST_COUNT&quot;) == null ? &quot;0&quot; : vars.get(&quot;REQUEST_COUNT&quot;);
String cartSubtotal = vars.get(&quot;CART_SUBTOTAL&quot;) == null ? &quot;N/A&quot; : vars.get(&quot;CART_SUBTOTAL&quot;);
String productName  = vars.get(&quot;PRODUCT_NAME&quot;)  == null ? &quot;N/A&quot; : vars.get(&quot;PRODUCT_NAME&quot;);
String resultCount  = vars.get(&quot;SEARCH_RESULT_matchNr&quot;) == null
                          ? &quot;0&quot; : vars.get(&quot;SEARCH_RESULT_matchNr&quot;);

StringBuilder summary = new StringBuilder();
summary.append(&quot;╔══════════════════════════════════════════╗\n&quot;);
summary.append(&quot;║       DemoWebShop – Test Summary         ║\n&quot;);
summary.append(&quot;╠══════════════════════════════════════════╣\n&quot;);
summary.append(&quot;║ Start Time      : &quot;).append(startTime).append(&quot;\n&quot;);
summary.append(&quot;║ End Time        : &quot;).append(endTime).append(&quot;\n&quot;);
summary.append(&quot;║ Thread          : &quot;).append(ctx.getThreadNum() + 1).append(&quot;\n&quot;);
summary.append(&quot;║ Total Requests  : &quot;).append(requestCount).append(&quot;\n&quot;);
summary.append(&quot;║ Passed          : &quot;).append(passCount).append(&quot;\n&quot;);
summary.append(&quot;║ Failed          : &quot;).append(failCount).append(&quot;\n&quot;);
summary.append(&quot;║ Product Tested  : &quot;).append(productName).append(&quot;\n&quot;);
summary.append(&quot;║ Cart Subtotal   : &quot;).append(cartSubtotal).append(&quot;\n&quot;);
summary.append(&quot;║ Search Results  : &quot;).append(resultCount).append(&quot;\n&quot;);
summary.append(&quot;╚══════════════════════════════════════════╝\n&quot;);

log.info(summary.toString());
SampleResult.setResponseData(summary.toString(), &quot;UTF-8&quot;);
SampleResult.setSuccessful(true);
SampleResult.setResponseCodeOK();
          </stringProp>
        </BeanShellSampler>
