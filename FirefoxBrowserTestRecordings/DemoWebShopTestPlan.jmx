        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="BeanShell – Validate Correlations" enabled="true">
          <stringProp name="BeanShellSampler.query">
import java.util.HashMap;

// ── Read correlated variables ────────────────────────────────────────
String loginToken   = vars.get(&quot;LOGIN_TOKEN&quot;);
String productUrl   = vars.get(&quot;PRODUCT_URL&quot;);
String productId    = vars.get(&quot;PRODUCT_ID&quot;);
String productName  = vars.get(&quot;PRODUCT_NAME&quot;);
String price1       = vars.get(&quot;PRICE_1&quot;);          // first element of the array
String custGuid     = vars.get(&quot;CUSTOMER_GUID&quot;);
int    requestCount = Integer.parseInt(vars.get(&quot;REQUEST_COUNT&quot;) == null
                          ? &quot;0&quot; : vars.get(&quot;REQUEST_COUNT&quot;)) + 1;
vars.put(&quot;REQUEST_COUNT&quot;, String.valueOf(requestCount));

// ── Build a validation report ────────────────────────────────────────
StringBuilder report = new StringBuilder();
report.append(&quot;===== Correlation Validation Report =====\n&quot;);
report.append(&quot;Thread        : &quot;).append(ctx.getThreadNum() + 1).append(&quot;\n&quot;);
report.append(&quot;Request Count : &quot;).append(requestCount).append(&quot;\n&quot;);
report.append(&quot;LOGIN_TOKEN   : &quot;).append(loginToken).append(&quot;\n&quot;);
report.append(&quot;CUSTOMER_GUID : &quot;).append(custGuid).append(&quot;\n&quot;);
report.append(&quot;PRODUCT_URL   : &quot;).append(productUrl).append(&quot;\n&quot;);
report.append(&quot;PRODUCT_ID    : &quot;).append(productId).append(&quot;\n&quot;);
report.append(&quot;PRODUCT_NAME  : &quot;).append(productName).append(&quot;\n&quot;);
report.append(&quot;PRICE_1       : &quot;).append(price1).append(&quot;\n&quot;);

// ── Determine pass / fail ────────────────────────────────────────────
boolean allOk = !(&quot;LOGIN_TOKEN_NOT_FOUND&quot;.equals(loginToken)
               || &quot;GUID_NOT_FOUND&quot;.equals(custGuid)
               || productUrl == null || productUrl.isEmpty()
               || &quot;13&quot;.equals(productId));   // default fallback check

if (allOk) {
    int pass = Integer.parseInt(vars.get(&quot;PASS_COUNT&quot;) == null
                   ? &quot;0&quot; : vars.get(&quot;PASS_COUNT&quot;)) + 1;
    vars.put(&quot;PASS_COUNT&quot;, String.valueOf(pass));
    SampleResult.setSuccessful(true);
    SampleResult.setResponseCodeOK();
    report.append(&quot;STATUS        : PASS\n&quot;);
} else {
    int fail = Integer.parseInt(vars.get(&quot;FAIL_COUNT&quot;) == null
                   ? &quot;0&quot; : vars.get(&quot;FAIL_COUNT&quot;)) + 1;
    vars.put(&quot;FAIL_COUNT&quot;, String.valueOf(fail));
    SampleResult.setSuccessful(false);
    SampleResult.setResponseCode(&quot;500&quot;);
    report.append(&quot;STATUS        : FAIL – one or more tokens not extracted\n&quot;);
}

report.append(&quot;=========================================&quot;);
log.info(report.toString());
SampleResult.setResponseData(report.toString(), &quot;UTF-8&quot;);
          </stringProp>
        </BeanShellSampler>
