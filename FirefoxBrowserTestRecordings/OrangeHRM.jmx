<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="OrangeHRM - JMeter Controllers Complete Demo">
      <stringProp name="TestPlan.comments">
        Complete JMeter Controller Demo using OrangeHRM Demo Site.
        Credentials: Admin / admin123
        URL: https://opensource-demo.orangehrmlive.com/
        Covers: Simple, Loop, OnceOnly, Interleave, Random, RandomOrder,
                Throughput, Runtime, If, While, Switch, ForEach,
                Transaction, Module, Recording Controllers
      </stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">opensource-demo.orangehrmlive.com</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="USERNAME" elementType="Argument">
            <stringProp name="Argument.name">USERNAME</stringProp>
            <stringProp name="Argument.value">Admin</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">PASSWORD</stringProp>
            <stringProp name="Argument.value">admin123</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="USER_ROLE" elementType="Argument">
            <stringProp name="Argument.name">USER_ROLE</stringProp>
            <stringProp name="Argument.value">Admin</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DEPARTMENT" elementType="Argument">
            <stringProp name="Argument.name">DEPARTMENT</stringProp>
            <stringProp name="Argument.value">HR</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="EMP_ID_1" elementType="Argument">
            <stringProp name="Argument.name">EMP_ID_1</stringProp>
            <stringProp name="Argument.value">1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="EMP_ID_2" elementType="Argument">
            <stringProp name="Argument.name">EMP_ID_2</stringProp>
            <stringProp name="Argument.value">2</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="EMP_ID_3" elementType="Argument">
            <stringProp name="Argument.name">EMP_ID_3</stringProp>
            <stringProp name="Argument.value">3</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="EMP_ID_4" elementType="Argument">
            <stringProp name="Argument.name">EMP_ID_4</stringProp>
            <stringProp name="Argument.value">4</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="EMP_ID_5" elementType="Argument">
            <stringProp name="Argument.name">EMP_ID_5</stringProp>
            <stringProp name="Argument.value">5</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="POLL_COUNTER" elementType="Argument">
            <stringProp name="Argument.name">POLL_COUNTER</stringProp>
            <stringProp name="Argument.value">0</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LEAVE_STATUS" elementType="Argument">
            <stringProp name="Argument.name">LEAVE_STATUS</stringProp>
            <stringProp name="Argument.value">Pending</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
